{
  "name": "Reflex RAG App",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev libgomp1",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [3001, 8002],
  "portsAttributes": {
    "3001": {
      "label": "Reflex Frontend",
      "onAutoForward": "openPreview"
    },
    "8002": {
      "label": "Reflex Backend",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python"
      }
    }
  }
}
