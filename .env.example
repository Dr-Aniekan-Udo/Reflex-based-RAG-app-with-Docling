# Required
GOOGLE_API_KEY=your-google-api-key-here

# Optional: LLM model selection
GEMINI_MODEL=gemini-2.5-flash

# Optional: Embedding configuration (tune for your API tier)
EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_BATCH_SIZE=100       # Max texts per batch call (Google limit: 100)
EMBEDDING_RPM_LIMIT=5          # Requests per minute (free tier: 5, paid: 100+)
EMBEDDING_MAX_RETRIES=5        # Retry attempts for rate-limited embedding calls

# Optional: HuggingFace token for faster model downloads
HF_TOKEN=your-huggingface-token

# Optional: Redis URL (defaults to localhost)
REDIS_URL=redis://localhost:6379/0
